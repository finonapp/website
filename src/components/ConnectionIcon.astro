---
/**
 * ConnectionIcon: a provider logo as a round white "coin" with a soft shadow.
 * The logo is circle-cropped inside, so logos with any background read the
 * same. `.coin-ping` is the ring that expands when scripts/coinPing.ts adds
 * `.is-pinging`.
 */
import { Image } from "astro:assets";
import type { Connection } from "../data/connections";

type Size = "sm" | "md" | "lg" | "xl";

interface Props {
  connection: Connection;
  size?: Size;
  class?: string;
}

const { connection, size = "md", class: className = "" } = Astro.props;

// Disc and logo diameters in px; the difference is the white padding.
const sizes: Record<Size, { disc: number; logo: number }> = {
  sm: { disc: 60, logo: 50 },
  md: { disc: 96, logo: 80 },
  lg: { disc: 120, logo: 100 },
  xl: { disc: 156, logo: 130 },
};
const { disc, logo } = sizes[size];
---

<span
  class:list={["connection-icon relative inline-flex items-center justify-center rounded-full bg-white shadow-coin select-none", className]}
  style={`width:${disc}px;height:${disc}px`}
  title={connection.name}
>
  {/* Rendered at 2x so the logo stays sharp on retina screens, shown at `logo` px. */}
  <Image
    src={connection.image}
    width={logo * 2}
    height={logo * 2}
    alt={connection.name}
    class="rounded-full object-cover"
    style={`width:${logo}px;height:${logo}px`}
    loading="eager"
  />
  <span class="coin-ping" aria-hidden="true"></span>
</span>

<style>
  /* Pop plus an expanding brand ring, played while .is-pinging is on (scripts/coinPing.ts).
     Both animate only scale and opacity, so they run on the compositor. */
  .coin-ping {
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    border: 2px solid var(--color-brand);
    opacity: 0;
    pointer-events: none;
  }

  .connection-icon.is-pinging {
    animation: coin-pop 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .connection-icon.is-pinging .coin-ping {
    animation: coin-ripple 950ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }

  @keyframes coin-pop {
    0%,
    100% {
      scale: 1;
    }
    35% {
      scale: 1.14;
    }
  }

  @keyframes coin-ripple {
    0% {
      scale: 1;
      opacity: 0.85;
    }
    100% {
      scale: 2.1;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connection-icon.is-pinging,
    .connection-icon.is-pinging .coin-ping {
      animation: none;
    }
  }
</style>
