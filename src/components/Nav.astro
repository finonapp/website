---
/**
 * Nav: one floating pill (page colour, blurred) fixed at the top, above the
 * Background halo. Logo left, three anchors in the middle (lg+), a brand
 * "Get the app" button right. Below lg the anchors move into a
 * details/summary menu; the script at the bottom only closes it.
 */
import { Menu } from "@lucide/astro";
import Logo from "../assets/finon-logo-word.svg";

const links = [
  { href: "/#", label: "Home" },
  { href: "/#features", label: "Features" },
  { href: "/#faq", label: "FAQ" },
];
const appStore = "https://apps.apple.com/gb/app/finon/id6751505655";
---

<header class="fixed inset-x-0 top-0 z-30 px-4 pt-4 sm:px-6">
  <nav
    class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 rounded-full border border-line bg-page/85 pr-2 pl-5 shadow-coin backdrop-blur-md"
    aria-label="Main"
  >
    <a href="/" class="flex items-center" aria-label="Finon home">
      <Logo width={108} aria-hidden="true" />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-4 py-2 text-sm font-medium text-ink-muted transition-colors hover:bg-surface hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <a
        href={appStore}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-hover"
      >
        Get the app
      </a>

      <details class="relative lg:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-ink hover:bg-surface [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Menu size={20} stroke-width={1.75} />
        </summary>
        <ul class="absolute right-0 mt-3 w-48 rounded-2xl border border-line bg-page p-2 shadow-coin-lg">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="block rounded-xl px-3 py-2 text-sm font-medium text-ink hover:bg-surface">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // <details> has no auto-close. Close the menu on a link tap, a click outside, or Escape.
  const menu = document.querySelector<HTMLDetailsElement>("header details");
  if (menu) {
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) menu.open = false;
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") menu.open = false;
    });
  }
</script>
