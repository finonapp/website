---
const { title, text, imageSrc, className } = Astro.props;
---

<article
  id="card"
  data-image-src={imageSrc}
  class={`border-[#DCDCDC] border-solid border-2  rounded-2xl p-4 max-w-180 transition-all ${className}`}
>
  <h1 class="font-bold text-lg">{title}</h1>
  <p class="text-sm">{text}</p>
</article>
