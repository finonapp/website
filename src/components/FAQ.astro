---
/**
 * FAQ: section title with the letter reveal, a one-line intro, then a native
 * details/summary accordion. `name="faq"` makes the browser keep one item open
 * at a time; the first is open by default. Used on the home page and /support.
 */
import { ChevronDown } from "@lucide/astro";
import Container from "./Container.astro";
import RevealHeading from "./RevealHeading.astro";
---

<section id="faq" class="flex flex-col gap-4 py-32" aria-labelledby="faq-heading">
  <RevealHeading
    id="faq-heading"
    text="Frequently asked questions"
    class="mx-auto max-w-2xl px-6 text-center text-3xl font-semibold leading-[1.15] tracking-[-0.02em] text-balance text-ink sm:text-4xl lg:text-[40px]"
  />
  <p class="px-6 text-center text-xl font-light text-balance text-ink-muted">
    Everything you need to know about Finon. Don’t see your question?
    <a class="underline" href="/support">Contact us</a>.
  </p>

  <Container>
    <details name="faq" class="group rounded-2xl border border-line bg-surface text-ink" open>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 [&::-webkit-details-marker]:hidden">
        <h3 class="font-semibold">Which account can I connect?</h3>
        <ChevronDown class="size-5 shrink-0 transition-transform duration-200 group-open:rotate-180" stroke-width={2.4} aria-hidden="true" />
      </summary>
      <p class="px-4 pb-4 text-sm text-ink-muted">
        We're starting with the UK's most popular banks and exchanges. We are expanding this list every month based on
        waitlist user requests, see our current connections
        <a
          href="https://docs.google.com/spreadsheets/d/1pqarJN8L3lZzMCyd4eQht-kttXtz7582prEfZoM1GZM/edit?usp=sharing"
          class="underline"
          target="_blank"
          rel="noopener">here</a
        >.
      </p>
    </details>

    <details name="faq" class="group rounded-2xl border border-line bg-surface text-ink">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 [&::-webkit-details-marker]:hidden">
        <h3 class="font-semibold">What account types do you support?</h3>
        <ChevronDown class="size-5 shrink-0 transition-transform duration-200 group-open:rotate-180" stroke-width={2.4} aria-hidden="true" />
      </summary>
      <p class="px-4 pb-4 text-sm text-ink-muted">
        We currently support bank accounts, crypto exchanges, and stock platforms. We are actively working to expand into
        other asset classes like pensions, commodities, and real estate.
      </p>
    </details>
  </Container>
</section>
