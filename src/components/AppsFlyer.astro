---
/**
 * AppsFlyer: use Finon's Smart Script configuration to attribute downloads.
 * Load on every page so incoming attribution survives navigation. Links
 * marked data-onelink already point at the plain OneLink, so they keep
 * working if the SDK cannot generate an attributed URL.
 */
import { ONELINK_URL } from "../data/links";
---

<script is:inline src="/scripts/appsflyer-smart-script-2.10.4.js" defer></script>
<script is:inline define:vars={{ oneLinkUrl: ONELINK_URL }}>
  // Deferred scripts finish before DOMContentLoaded, when every CTA is present.
  document.addEventListener("DOMContentLoaded", () => {
    try {
      const result = window.AF_SMART_SCRIPT?.generateOneLinkURL({
        oneLinkURL: oneLinkUrl,
        SEO: true,
        afParameters: {
          mediaSource: {
            keys: ["utm_source", "utm_content"],
            defaultValue: "any_source",
          },
          afCustom: [{ paramKey: "af_ss_ui", defaultValue: "true" }],
        },
      });

      if (!result?.clickURL) return;

      document.querySelectorAll("a[data-onelink]").forEach((link) => {
        link.href = result.clickURL;
      });
    } catch (error) {
      // Storage restrictions or SDK errors must not prevent app downloads.
      console.warn("AppsFlyer attribution unavailable; using the plain OneLink.", error);
    }
  }, { once: true });
</script>
