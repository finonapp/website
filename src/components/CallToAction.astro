---
/** CallToAction: fixed dark block above the footer with the App Store badge. Also used on /support. */
import ActionButton from "./ActionButton.astro";
import Container from "./Container.astro";
---

<section class="bg-night py-22 text-white">
  <Container class="flex flex-col items-center gap-12 text-center">
    <div class="flex flex-col gap-4">
      <h2 class="text-4xl font-bold">Ready for a simpler way to manage your finances?</h2>
      <p class="font-light">Connect all your accounts effortlessly and see your full portfolio in one simple view.</p>
    </div>
    <ActionButton />
  </Container>
</section>
