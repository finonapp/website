---
import ActionButton from "./ActionButton.astro";
import Container from "./Container.astro";
---

<section class="py-22 bg-[#272528] dark:bg-black text-white">
  <Container class="text-center flex gap-12 flex-col items-center">
    <div class="flex flex-col gap-4">
      <h1 class="font-bold text-4xl">
        Ready for a simpler way to manage your finances?
      </h1>
      <p class="font-light">
        Connect all your accounts effortlessly and see your full portfolio in
        one simple view.
      </p>
    </div>
    <ActionButton />
  </Container>
</section>
