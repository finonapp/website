---
/** CallToAction: shared dark section above the footer with the App Store badge. */
import ActionButton from "./ActionButton.astro";
import Container from "./Container.astro";
---

<section class="bg-night py-22 text-white">
  <Container class="flex flex-col items-center gap-12 text-center">
    <div class="flex flex-col gap-4">
      <h2 class="text-4xl font-bold">Ready for a simpler way to manage your finances?</h2>
      <p class="font-light">Track your investments, bank balances and crypto in one place.</p>
    </div>
    <div class="flex flex-col items-center gap-3">
      <ActionButton />
      <p class="text-sm text-white/70">Free on iOS. UK only.</p>
    </div>
  </Container>
</section>
