---
/** Supported accounts and methods, reviewed against the app's src/connect/list.ts and connection flows. */
import ActionButton from "../components/ActionButton.astro";
import CallToAction from "../components/CallToAction.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";

const banks = ["Barclays", "Chase", "Lloyds Bank", "Monzo", "Revolut", "Santander", "Wise"];
const investmentConnections = [
  { name: "Trading 212", assets: "Stocks and cash", method: "API key with read-only permissions" },
  { name: "Coinbase", assets: "Crypto", method: "Authorise your Coinbase account" },
  { name: "Bitget", assets: "Crypto", method: "API key with read-only permissions" },
];
---

<Layout
  title="Supported Banks & Investment Connections – Finon"
  description="Explore the banks, brokers and crypto exchanges you can track with Finon. Connect accounts, import Freetrade and Moneybox statements, or add commodities."
>
  <Nav />
  <main>
    <section class="pt-32 pb-12 sm:pt-40 sm:pb-16" aria-labelledby="connections-heading">
      <Container>
        <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">Supported connections</p>
          <h1 id="connections-heading" class="text-4xl font-semibold leading-tight tracking-[-0.03em] text-balance sm:text-5xl">
            Your banks, investments and crypto. Together.
          </h1>
          <p class="max-w-2xl text-lg leading-relaxed text-ink-muted">
            Bring your accounts into Finon to track investments and bank balances in one place.
            Connect supported providers, import statements or add commodities manually.
          </p>
          <ActionButton />
          <p class="text-sm text-ink-muted">For UK users. Free to download, with premium features available.</p>
        </div>
      </Container>
    </section>

    <section class="py-10 sm:py-16" aria-labelledby="banks-heading">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
          <div class="flex flex-col gap-4">
            <h2 id="banks-heading" class="text-3xl font-semibold tracking-tight">Connect your bank accounts</h2>
            <p class="leading-relaxed text-ink-muted">
              Authorise access through your bank using Open Banking. Finon brings the balances
              from your supported accounts into your dashboard, alongside your investments.
            </p>
            <p class="text-sm leading-relaxed text-ink-muted">
              Account coverage varies by bank. The authorisation step shows which accounts you
              can share. You may need to renew access to keep a connection updated.
            </p>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2" aria-label="Supported banks">
            {banks.map((bank) => (
              <li class="flex items-center rounded-2xl border border-line bg-surface px-6 py-5 font-medium">{bank}</li>
            ))}
          </ul>
        </div>
      </Container>
    </section>

    <section class="py-10 sm:py-16" aria-labelledby="investments-heading">
      <Container>
        <div class="mb-8 flex max-w-2xl flex-col gap-4">
          <h2 id="investments-heading" class="text-3xl font-semibold tracking-tight">Track your stocks and crypto</h2>
          <p class="leading-relaxed text-ink-muted">
            Add these accounts to see your holdings alongside your bank balances. Follow the
            connection steps in Finon and grant only the read-only permissions requested.
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {investmentConnections.map(({ name, assets, method }) => (
            <article class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6">
              <h3 class="text-xl font-semibold">{name}</h3>
              <dl class="flex flex-col gap-4 text-sm">
                <div>
                  <dt class="font-medium">What you can track</dt>
                  <dd class="mt-1 text-ink-muted">{assets}</dd>
                </div>
                <div>
                  <dt class="font-medium">How to connect</dt>
                  <dd class="mt-1 text-ink-muted">{method}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
        <p class="mt-6 max-w-3xl text-sm leading-relaxed text-ink-muted">
          Balances and holdings reflect the latest available sync. If a connection needs attention,
          follow the reconnect instructions in the app. Finon cannot place trades or transfer funds.
        </p>
      </Container>
    </section>

    <section id="statement-imports" class="scroll-mt-24 py-10 sm:py-16" aria-labelledby="imports-heading">
      <Container>
        <div class="mb-8 flex max-w-2xl flex-col gap-4">
          <h2 id="imports-heading" class="text-3xl font-semibold tracking-tight">Bring in your statements</h2>
          <p class="leading-relaxed text-ink-muted">
            Track holdings from Freetrade and Moneybox by importing files. These accounts update
            when you upload new statements, so you choose when to bring them up to date.
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <article class="flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6">
            <h3 class="text-xl font-semibold">Freetrade</h3>
            <p class="leading-relaxed text-ink-muted">
              Download your monthly PDF statement and export your activity as a CSV from Freetrade.
              Follow the in-app instructions to import your files into Finon.
            </p>
          </article>
          <article class="flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6">
            <h3 class="text-xl font-semibold">Moneybox</h3>
            <p class="leading-relaxed text-ink-muted">
              Request a PDF statement from Moneybox, then upload it using the import steps in Finon.
              The app guides you through choosing and downloading the statement.
            </p>
          </article>
        </div>
      </Container>
    </section>

    <section class="pt-10 pb-20 sm:pt-16 sm:pb-28" aria-labelledby="manual-heading">
      <Container>
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
          <div class="flex flex-col gap-4">
            <h2 id="manual-heading" class="text-3xl font-semibold tracking-tight">Add commodities manually</h2>
            <p class="leading-relaxed text-ink-muted">
              Add holdings such as gold and silver to include them in your tracked portfolio.
              Manual entry currently supports commodities; it does not connect an unsupported bank or broker.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <h2 class="text-3xl font-semibold tracking-tight">Looking for another provider?</h2>
            <p class="leading-relaxed text-ink-muted">
              Check the account list in the app for current availability. If your provider is missing,
              <a href="/support" class="text-brand underline underline-offset-4">contact Finon support</a>
              and tell us what you would like to track.
            </p>
            <a href="/#features" class="font-medium text-brand underline underline-offset-4">Explore Finon’s investment tracking features</a>
          </div>
        </div>
      </Container>
    </section>
    <CallToAction />
  </main>
  <Footer />
</Layout>
