---
/** An API-backed directory, rendered at build time for SEO and refreshed in the browser. */
import CallToAction from "../components/CallToAction.astro";
import ConnectionCard from "../components/ConnectionCard.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";
import { fetchConnections, type LiveConnection } from "../lib/connections";

let connections: LiveConnection[] = [];
let checkedAt = "";
try {
  connections = await fetchConnections();
  checkedAt = new Date().toISOString();
} catch (error) {
  // The directory can still load in the browser if the API is unavailable during a build.
  console.warn("Could not prerender connections:", error instanceof Error ? error.message : error);
}
---

<Layout
  title="Supported Banks & Investment Connections – Finon"
  description="See which banks, investment platforms and crypto exchanges are available in Finon. Check the latest connection availability and track your money in one place."
>
  <Nav />
  <main class="pt-32 sm:pt-40">
    <Container class="pb-16 sm:pb-24">
      <div class="mx-auto max-w-5xl">
        <header class="mx-auto mb-10 max-w-2xl text-center sm:mb-14">
          <h1 class="text-4xl font-semibold leading-tight tracking-[-0.03em] text-balance sm:text-5xl">Your connections, in one place</h1>
          <p class="mt-5 text-lg leading-relaxed text-ink-muted">
            Find your banks, investment platforms and crypto exchanges.
            See what’s available to connect with Finon.
          </p>
        </header>

        <section aria-labelledby="directory-heading" data-connections-directory data-checked-at={checkedAt}>
          <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h2 id="directory-heading" class="text-lg font-semibold">Connections</h2>
            <time data-connections-checked datetime={checkedAt} hidden={!checkedAt} class="text-sm text-ink-muted">
              {checkedAt && `Last checked ${new Date(checkedAt).toLocaleString("en-GB", { timeZone: "UTC", dateStyle: "medium", timeStyle: "short" })} UTC`}
            </time>
          </div>
          <ul data-connections-list class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {connections.map((connection) => <ConnectionCard connection={connection} />)}
          </ul>
          <p data-connections-empty hidden={connections.length > 0} class="rounded-2xl border border-line bg-surface p-8 text-center text-ink-muted">
            {checkedAt ? "No connections are listed right now. Please check again later." : "Loading connections…"}
          </p>
          <template data-connection-template><ConnectionCard /></template>
          <noscript>
            <p class="mt-4 text-sm text-ink-muted">
              {!checkedAt && "The connection list could not be loaded."}
              Enable JavaScript for automatic updates, or check availability in the Finon app.
            </p>
            <style is:inline>[data-connections-empty] { display: none; }</style>
          </noscript>
        </section>

        <div id="statement-imports" class="mt-10 scroll-mt-24 border-t border-line pt-6 text-sm leading-relaxed text-ink-muted">
          <p>Connection methods vary by provider, including account linking and statement imports. Follow the steps in the app to get started.</p>
          <p class="mt-2">Can’t find your provider? <a href="/support" class="text-brand underline underline-offset-4">Let us know</a>.</p>
        </div>
      </div>
    </Container>
    <CallToAction />
</main>
  <Footer />
</Layout>

<script>
  import { initConnectionsDirectory } from "../scripts/connectionsDirectory";
  initConnectionsDirectory();
</script>
