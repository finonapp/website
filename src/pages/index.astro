---
/** Home page: hero, features, founder note and FAQ on the halo background, then the CTA. */
import ActionButton from "../components/ActionButton.astro";
import Background from "../components/Background.astro";
import CallToAction from "../components/CallToAction.astro";
import ConnectionStack from "../components/ConnectionStack.astro";
import Container from "../components/Container.astro";
import FAQ from "../components/FAQ.astro";
import Features from "../components/Features.astro";
import FloatingConnections from "../components/FloatingConnections.astro";
import Footer from "../components/Footer.astro";
import FounderNote from "../components/FounderNote.astro";
import Nav from "../components/Nav.astro";
import { FAQ_ITEMS } from "../data/faq";
import { APP_STORE_URL, PLAY_STORE_URL } from "../data/links";
import Layout from "../layouts/Layout.astro";

const schema = [
  {
    "@type": "MobileApplication",
    "@id": new URL("/#app", Astro.site).href,
    name: "Finon",
    description:
      "Personal finance app for UK users. Track bank balances, investments and crypto in one read-only dashboard.",
    applicationCategory: "FinanceApplication",
    operatingSystem: "iOS, Android",
    url: new URL("/", Astro.site).href,
    installUrl: [APP_STORE_URL, PLAY_STORE_URL],
    countriesSupported: "GB",
    inLanguage: "en-GB",
    offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
    publisher: { "@id": new URL("/#organization", Astro.site).href },
  },
  {
    "@type": "FAQPage",
    mainEntity: FAQ_ITEMS.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Finon – UK Personal Financial App to Track Investments"
  description="Track investments, bank accounts and crypto in one read-only dashboard. Finon is a free UK personal financial app for iPhone and Android."
  schema={schema}
>
  <Nav />
  <main>
    <Background>
      <!-- Hero: copy in the middle, coins floating around it on lg, a coin stack under the copy below lg. -->
      <section class="relative flex min-h-[88svh] items-center overflow-hidden pt-28 pb-20 lg:pt-32 lg:pb-28">
        <FloatingConnections />
        <Container class="relative z-10">
          <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
            <h1 class="text-5xl font-semibold leading-[1.02] tracking-[-0.03em] text-balance text-ink sm:text-6xl lg:text-7xl">
              All your <span class="font-bold text-brand">finances</span> in <span class="text-brand">one</span> place
            </h1>
            <p class="max-w-3xl text-lg text-balance text-ink-muted lg:text-xl">
              The personal financial app for a clearer view of your money. Track investments,
              bank balances and crypto together in one read-only dashboard.
            </p>
            <div class="mt-2 flex flex-col items-center gap-3">
              <ActionButton />
              <p class="max-w-sm text-sm text-ink-muted">Free on iOS and Android. UK only.</p>
            </div>
            <ConnectionStack class="mt-6 lg:hidden" />
          </div>
        </Container>
      </section>

      <Features />
      <FounderNote />
      <FAQ />
    </Background>
    <CallToAction />
  </main>
  <Footer />
</Layout>
